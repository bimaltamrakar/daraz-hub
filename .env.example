NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# Supabase Supavisor transaction pooler (runtime). Replace project ref, region, and URL-encoded DB password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Supavisor session pooler (Prisma migrations/CLI). Use the matching project and password.
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password
COOKIE_SECURE=false
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OAUTH_STATE_TTL_MINUTES=10

# JSON object keyed by ISO region code. Keep this value on one line in .env.
# Daraz serves its REST gateway per marketplace: api.daraz.com.np, api.daraz.pk, api.daraz.com.bd, api.daraz.lk, api.shop.com.mm (+ /rest).
# The generic api.daraz.com host does NOT resolve. apiBaseUrl is optional; when omitted it is derived from the authorizeUrl host.
DARAZ_REGIONS_JSON={"NP":{"authorizeUrl":"https://api.daraz.com.np/oauth/authorize","apiBaseUrl":"https://api.daraz.com.np/rest","appKey":"SET_FROM_DARAZ_CONSOLE","appSecret":"SET_FROM_DARAZ_CONSOLE","redirectUri":"https://YOUR_PUBLIC_HOST/api/oauth/daraz/callback"}}