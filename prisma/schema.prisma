generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  user
}

enum StoreStatus {
  pending
  connected
  expiring_soon
  expired
  error
}

enum OrderSyncFrequency {
  manual
  every_15_minutes
  hourly
  every_6_hours
  daily
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  passwordHash       String
  role               Role         @default(user)
  isActive           Boolean      @default(true)
  mustChangePassword Boolean      @default(false)
  createdAt          DateTime     @default(now())
  stores             Store[]
  sessions           Session[]
  oauthStates        OAuthState[]
  auditLogs          AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Store {
  id                 String             @id @default(cuid())
  userId             String
  label              String
  country            String
  sellerId           String?
  status             StoreStatus        @default(pending)
  // Seller identity captured from the Daraz token response at authorization time.
  account            String?
  accountPlatform    String?
  darazCountry       String?
  darazUserId        String?
  shortCode          String?
  connectedAt        DateTime?
  // Seller profile captured from Daraz /seller/get after authorization.
  sellerName         String?
  companyName        String?
  sellerEmail        String?
  sellerStatus       String?
  verified           Boolean?
  location           String?
  profile            Json?
  profileFetchedAt   DateTime?
  profileError       String?
  orderSyncFrom      DateTime           @default(now())
  orderSyncFrequency OrderSyncFrequency @default(hourly)
  orderSyncCursor    DateTime?
  orderSyncLastAt    DateTime?
  productSyncLastAt  DateTime?
  orderSyncNextAt    DateTime?
  orderSyncLockId    String?
  orderSyncLockUntil DateTime?
  orderSyncError     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens             StoreToken?
  oauthStates        OAuthState[]
  auditLogs          AuditLog[]
  orders             StoreOrder[]
  products           ProductMaster[]

  @@index([userId])
  @@index([orderSyncNextAt])
}

model StoreOrder {
  id             String    @id @default(cuid())
  storeId        String
  darazOrderId   String
  customerName   String?
  orderCreatedAt DateTime
  orderUpdatedAt DateTime?
  orderStatus    String?
  deliveryStatus String?
  trackingNumber String?
  rawDetails     Json
  syncedAt       DateTime  @default(now())
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, darazOrderId])
  @@index([storeId, orderCreatedAt])
  @@index([storeId, orderUpdatedAt])
  @@index([orderStatus])
  @@index([deliveryStatus])
}

model ProductMaster {
  id          String   @id @default(cuid())
  storeId     String
  darazItemId String
  sellerSku   String?
  name        String?
  status      String?
  rawDetails  Json
  fetchedAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, darazItemId])
  @@index([storeId, sellerSku])
  @@index([storeId, name])
}

model StoreToken {
  storeId          String    @id
  accessTokenEnc   String
  refreshTokenEnc  String
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  lastRefreshedAt  DateTime?
  lastError        String?
  updatedAt        DateTime  @updatedAt
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model OAuthState {
  state     String   @id
  userId    String
  storeId   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  storeId   String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}
