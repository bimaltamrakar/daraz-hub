generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  user
}

enum StoreType {
  normal
  choice
}

enum StoreStatus {
  pending
  connected
  expiring_soon
  expired
  error
}

enum OrderSyncFrequency {
  manual
  every_15_minutes
  hourly
  every_6_hours
  daily
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  passwordHash       String
  role               Role         @default(user)
  isActive           Boolean      @default(true)
  mustChangePassword Boolean      @default(false)
  createdAt          DateTime     @default(now())
  stores             Store[]
  sessions           Session[]
  oauthStates        OAuthState[]
  auditLogs          AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Store {
  id                 String             @id @default(cuid())
  userId             String
  label              String
  country            String
  // Inactive stores stay configured but are hidden from lists, reports and syncs.
  isActive           Boolean            @default(true)
  // Normal sellers print their own AWBs; Choice sellers are fulfilled by Daraz.
  storeType          StoreType          @default(normal)
  sellerId           String?
  status             StoreStatus        @default(pending)
  // Seller identity captured from the Daraz token response at authorization time.
  account            String?
  accountPlatform    String?
  darazCountry       String?
  darazUserId        String?
  shortCode          String?
  connectedAt        DateTime?
  // Seller profile captured from Daraz /seller/get after authorization.
  sellerName         String?
  companyName        String?
  sellerEmail        String?
  sellerStatus       String?
  verified           Boolean?
  location           String?
  profile            Json?
  profileFetchedAt   DateTime?
  profileError       String?
  orderSyncFrom      DateTime           @default(now())
  orderSyncFrequency OrderSyncFrequency @default(hourly)
  orderSyncCursor    DateTime?
  // Resumable initial backfill: when null and orderBackfillDone is false, sync starts at orderSyncFrom.
  orderBackfillCursor DateTime?
  orderBackfillDone   Boolean           @default(false)
  orderSyncLastAt    DateTime?
  productSyncLastAt  DateTime?
  productSyncNextAt  DateTime?
  productSyncOffset  Int                @default(0)
  productSyncLockId  String?
  productSyncLockUntil DateTime?
  productSyncError   String?
  orderSyncNextAt    DateTime?
  orderSyncLockId    String?
  orderSyncLockUntil DateTime?
  orderSyncError     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens             StoreToken?
  oauthStates        OAuthState[]
  auditLogs          AuditLog[]
  orders             StoreOrder[]
  products           ProductMaster[]
  variants           ProductVariant[]

  @@index([userId])
  @@index([orderSyncNextAt])
}

model ImsSetting {
  id            String    @id @default("default")
  baseUrl       String    @default("https://ecomapi.imssoftware.com.np/api")
  companyId     String
  branchCode    String
  imsUser       String
  warehouse     String    @default("Main Warehouse")
  paymentMode   String    @default("cash")
  voucherType   String    @default("TI")
  apiKeyEnc     String?
  usernameEnc   String?
  passwordEnc   String?
  apiSecretEnc  String?
  tokenEnc      String?
  tokenExpiresAt DateTime?
  lastTestedAt  DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ImsInvoice {
  id                String    @id @default(cuid())
  trackingNumber    String
  trackingNormalized String   @unique
  imsInvoiceNumber  String?
  invoiceDate       DateTime?
  generatedAt       DateTime?
  generatedById     String?
  generatedByName   String?
  pdfPath           String?
  status            String    @default("pending")
  imsResponse       Json?
  error             String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  orders            ImsInvoiceOrder[]
  @@index([imsInvoiceNumber])
  @@index([status])
  @@index([generatedAt])
}

model ImsInvoiceOrder {
  invoiceId String
  orderId   String
  invoice   ImsInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order     StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@id([invoiceId, orderId])
  @@unique([orderId])
}

model StoreOrder {
  id             String    @id @default(cuid())
  storeId        String
  darazOrderId   String
  customerName   String?
  orderCreatedAt DateTime
  orderUpdatedAt DateTime?
  orderStatus    String?
  deliveryStatus String?
  trackingNumber String?
  // Normalized group used by the Order Management tabs: unpaid, to_ship, shipping,
  // delivered, failed_delivery, canceled, returned.
  statusGroup    String?
  amount         Decimal?  @db.Decimal(14, 2)
  itemCount      Int?
  rawDetails     Json
  itemsSyncedAt  DateTime?
  syncedAt       DateTime  @default(now())
  imsInvoiceOrders ImsInvoiceOrder[]
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, darazOrderId])
  @@index([storeId, orderCreatedAt])
  @@index([storeId, orderUpdatedAt])
  @@index([storeId, statusGroup])
  @@index([orderStatus])
  @@index([deliveryStatus])
}

model ProductMaster {
  id           String   @id @default(cuid())
  storeId      String
  darazItemId  String
  sellerSku    String?
  name         String?
  brand        String?
  status       String?
  imageUrl     String?
  price        Decimal? @db.Decimal(14, 2)
  specialPrice Decimal? @db.Decimal(14, 2)
  quantity     Int?
  variation    Json?
  // "catalog" for products fetched from Daraz, "order" for SKUs discovered in an order.
  syncedFrom   String?  @default("catalog")
  rawDetails   Json
  fetchedAt    DateTime @default(now())
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants     ProductVariant[]

  @@unique([storeId, darazItemId])
  @@index([storeId, sellerSku])
  @@index([storeId, name])
}

model ProductVariant {
  id           String   @id @default(cuid())
  storeId      String
  productId    String
  sku          String
  darazSkuId   String?
  name         String?
  color        String?
  size         String?
  price        Decimal? @db.Decimal(14, 2)
  specialPrice Decimal? @db.Decimal(14, 2)
  quantity     Int?
  status       String?
  imageUrl     String?
  rawDetails   Json?
  updatedAt    DateTime @updatedAt
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product      ProductMaster @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, sku])
  @@index([productId])
}

model StoreToken {
  storeId          String    @id
  accessTokenEnc   String
  refreshTokenEnc  String
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  lastRefreshedAt  DateTime?
  lastError        String?
  updatedAt        DateTime  @updatedAt
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model OAuthState {
  state     String   @id
  userId    String
  storeId   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  storeId   String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}
